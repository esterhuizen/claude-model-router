{
  "description": "Injects the model-routing cost policy into every session at start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/routing-context.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
